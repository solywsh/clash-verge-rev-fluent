    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.11",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint -c eslint.config.ts --fix"
